ix/2026-06-28_Race/TeamRadio/HUL_27_20260628_141647.mp3","f":"HUL_27_20260628_141647.mp3","cap":"Thank you for watching."}],"LEC":[{"lap":57,"t":"14:12:37","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/LEC_16_20260628_161214.mp3","f":"LEC_16_20260628_161214.mp3","cap":"This car is off."},{"lap":59,"t":"14:15:10","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/LEC_16_20260628_161444.mp3","f":"LEC_16_20260628_161444.mp3","cap":"What have we got for this? Just don't forget. No, nothing."}],"NOR":[{"lap":20,"t":"13:27:28","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/NOR_1_20260628_152707.mp3","f":"NOR_1_20260628_152707.mp3","cap":"Lando, we're going to stay out, you'll get cleaner, we're going to extend. I've got no more pace, so this is it."}],"PER":[{"lap":5,"t":"13:09:10","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/PER_11_20260628_150840.mp3","f":"PER_11_20260628_150840.mp3","cap":"I'll follow that up as well because I think that's it."}],"PIA":[{"lap":1,"t":"12:32:40","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/PIA_81_20260628_143201.mp3","f":"PIA_81_20260628_143201.mp3","cap":"Um, can we just check that the left side of my seat, I mean, I guess it's coming out, anyway, but it feels like it's not properly in, uh, like around my left leg. Probably not, yeah."}],"RUS":[{"lap":10,"t":"13:15:16","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/RUS_63_20260628_151458.mp3","f":"RUS_63_20260628_151458.mp3","cap":"So Verstappen could trigger this early, he is very close to Lewis, every extra second we can get."},{"lap":17,"t":"13:23:22","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/RUS_63_20260628_152244.mp3","f":"RUS_63_20260628_152244.mp3","cap":"I think it's all started, I think he said the one stop is impossible. I think so."},{"lap":46,"t":"13:59:28","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/RUS_63_20260628_155900.mp3","f":"RUS_63_20260628_155900.mp3","cap":"Lawson, Kimi keeps extending, Verstappen's gonna keep on extending, Antonelli, Sainz, De Prys."},{"lap":71,"t":"14:31:23","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/RUS_63_20260628_163044.mp3","f":"RUS_63_20260628_163044.mp3","cap":"Good job, mate. Woo! That was two years ago, yabba-dabba-doo! Yabba-dabba-doo. Good job. Well, well done, guys. I'm happy. Well done. Thank you so much. Good team Brazil. Well done. Well done, everybody."},{"lap":71,"t":"14:32:55","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/RUS_63_20260628_163222.mp3","f":"RUS_63_20260628_163222.mp3","cap":"Drink system failed, nice race for it to do so. I'm a little bit thirsty. Great job. Well, have a drink ready for your podium."}],"VER":[{"lap":12,"t":"13:17:16","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/VER_3_20260628_151652.mp3","f":"VER_3_20260628_151652.mp3","cap":"All right, step, step back."},{"lap":46,"t":"13:58:55","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/VER_3_20260628_155813.mp3","f":"VER_3_20260628_155813.mp3","cap":"So, yeah, best you can at this stage of the race, we'll just try to build a bit of a tyre offset, hope he gets into trouble towards the end. Copy."},{"lap":71,"t":"14:32:24","url":"https://livetiming.formula1.com/static/2026/2026-06-28_Austrian_Grand_Prix/2026-06-28_Race/TeamRadio/VER_3_20260628_163139.mp3","f":"VER_3_20260628_163139.mp3","cap":"Ah, good job, Max. Well done. Throwing the... Throwing the wheels off it, that's normal. Thanks for the help."}]},"9":{"ALB":[{"lap":35,"t":"15:02:54","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ALB_23_20260705_160209.mp3","f":"ALB_23_20260705_160209.mp3","cap":"Alex, small feedback, please, for you, the wake now towards 4, load, copy, this way, 4, load. Same as the simulator, keep it to a full DD slope. Can't really do it whilst I'm driving. Copy."}],"ANT":[{"lap":41,"t":"15:08:59","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_160837.mp3","f":"ANT_12_20260705_160837.mp3","cap":"Country broken in the car."},{"lap":42,"t":"15:10:31","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161020.mp3","f":"ANT_12_20260705_161020.mp3","cap":"Suspension is broken. Copy, copy."},{"lap":42,"t":"15:11:01","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161048.mp3","f":"ANT_12_20260705_161048.mp3","cap":"We think it is just the wheel shield left hand side."},{"lap":44,"t":"15:13:04","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161231.mp3","f":"ANT_12_20260705_161231.mp3","cap":"Okay, we're going to try to box the goal, we'll try and remove the wheel shield and go again."},{"lap":45,"t":"15:15:05","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161440.mp3","f":"ANT_12_20260705_161440.mp3","cap":"I may not, there's something deeper. I've no front, the wheel is in the air. OK, we'll box the car. So this is to retire."},{"lap":45,"t":"15:16:07","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161533.mp3","f":"ANT_12_20260705_161533.mp3","cap":"We are just in P10, we've got Colapinto behind."},{"lap":46,"t":"15:18:10","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_161752.mp3","f":"ANT_12_20260705_161752.mp3","cap":"I'm gonna go for it, mate."},{"lap":49,"t":"15:22:43","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_162224.mp3","f":"ANT_12_20260705_162224.mp3","cap":"Everything is going against us, unbelievable. It feels like one of those days."},{"lap":50,"t":"15:24:16","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/ANT_12_20260705_162333.mp3","f":"ANT_12_20260705_162333.mp3","cap":"We do have a 5 second penalty for track limit. Yeah, but that's a joke mate, I didn't do it on purpose. Like, the car was broken. Yeah, understood. Like, I wasn't even getting time. Yeah, I know mate, I know mate."}],"COL":[{"lap":52,"t":"15:43:33","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/COL_43_20260705_164254.mp3","f":"COL_43_20260705_164254.mp3","cap":"Oh mate, so that's points to the team after, I'd say, a pretty difficult weekend. Yep, but we still thank you for all the effort."}],"HAD":[{"lap":52,"t":"15:40:29","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/HAD_6_20260705_163932.mp3","f":"HAD_6_20260705_163932.mp3","cap":"That's P5 to me, P5. I don't know what the hell that was. I mean, obviously I was on the tyre again, but you don't get that much time. That was just, yep, big loss. Big loss of road. Don't be that. Oh yeah, yeah, yeah. I won't say the points. Yeah, but I wanted to go to the front, not like... Behind, back, I know mate, I know. Yeah, yeah, yeah. Still stuff to work on. We'll work on it together."}],"HAM":[{"lap":24,"t":"14:40:34","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/HAM_44_20260705_154016.mp3","f":"HAM_44_20260705_154016.mp3","cap":"And box, box. And my tyres are still good, my tyres are still good."},{"lap":26,"t":"14:45:10","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/HAM_44_20260705_154456.mp3","f":"HAM_44_20260705_154456.mp3","cap":"We are P6, we are fighting for the podium, P3."}],"LIN":[{"lap":52,"t":"15:42:01","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/LIN_41_20260705_164102.mp3","f":"LIN_41_20260705_164102.mp3","cap":"Well done, Leclerc. Another amazing result. Apologies for Leclerc. It's a lesson. Yeah, I'm going to be honest. That annoys me. Not at you, but yeah, I'm not bad at you. It's just, yeah, it's really frustrating. But regardless, it's a good team effort. We'll keep working. It's a good day for the team, but not good enough. We need to give you all the tools, so we'll do better. Apologies."}],"NOR":[{"lap":52,"t":"15:37:28","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/NOR_1_20260705_163702.mp3","f":"NOR_1_20260705_163702.mp3","cap":"Lewis has overtaken everyone, I mean, that's just, everyone's overtaken. You just do the right thing. Yeah, I'm just trying to stay out of everyone's way, I mean, they're just racers, John. Everyone gets to qualify, you know, on the podium. Um, there's been confusing messages, honestly, I'm not sure."}],"RUS":[{"lap":33,"t":"14:56:18","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/RUS_63_20260705_155542.mp3","f":"RUS_63_20260705_155542.mp3","cap":"Move me or you do."},{"lap":35,"t":"14:59:22","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/RUS_63_20260705_155847.mp3","f":"RUS_63_20260705_155847.mp3","cap":"Oh my god."},{"lap":52,"t":"15:33:22","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/RUS_63_20260705_163250.mp3","f":"RUS_63_20260705_163250.mp3","cap":"Pardon for sticking in there, but that's really fine, going on top of the straight line speed, so that was a very frustrating weekend, otherwise, we got lucky with the race. Yeah, George, I think straight line was okay in the race."}],"VER":[{"lap":1,"t":"14:01:01","url":"https://livetiming.formula1.com/static/2026/2026-07-05_British_Grand_Prix/2026-07-05_Race/TeamRadio/VER_3_20260705_150051.mp3","f":"VER_3_20260705_150051.mp3","cap":""}]},"10":{"ANT":[{"lap":17,"t":"13:37:49","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/ANT_12_20260719_153716.mp3","f":"ANT_12_20260719_153716.mp3","cap":"Your tyres are looking good Kimi, better than others so you can afford to use them."},{"lap":40,"t":"14:20:58","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/ANT_12_20260719_162042.mp3","f":"ANT_12_20260719_162042.mp3","cap":"Remember track limits. 2, we have 2 already, so we don't want any more."},{"lap":45,"t":"14:29:37","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/ANT_12_20260719_162911.mp3","f":"ANT_12_20260719_162911.mp3","cap":"Nice work, Kimi. Well done there, mate. Let's go! Good effort, mate. Let's go. Thank you so much, guys. Yeah, well done, mate. Thank you. Yeah, it was a busy race, that one, but well done."},{"lap":45,"t":"14:33:43","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/ANT_12_20260719_163325.mp3","f":"ANT_12_20260719_163325.mp3","cap":"Bravo mate, bravo. Give me bravo. Bravo."}],"BEA":[{"lap":44,"t":"14:34:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/BEA_87_20260719_163702.mp3","f":"BEA_87_20260719_163702.mp3","cap":"Thanks everyone. Aside from those, I don't really have to read all the comments out today, so that should be posted."}],"BOR":[{"lap":44,"t":"14:34:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/BOR_5_20260719_163412.mp3","f":"BOR_5_20260719_163412.mp3","cap":"That's P8, P8, more than, more than, charge up, more than, and we drive into turn 1. What a race you have driven, Gabi, what a race, unbelievable. I go backwards? I go backwards? Yes, yes, yes, coming to the pit, drive it slowly. I mean, what a race, amazing driving. Oh my god! Mega job, mega job, mega quality, thank you very much. again fantastic job really well deserved you did a fun to put out a fight um but we were fight out there and great job for the team on the pit stop double stack getting you and nico in a good time for double points yes thanks everyone what a weekend amazing i don't want you to take off again thank you and remember Full switch off when you're around too much, man. And again, what a fight you put out there today. Really well deserved P8. Fantastic job, mate. And the team and the guys in the pit slot did a fantastic job as well. Fantastic. Great job."}],"HAD":[{"lap":44,"t":"14:34:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAD_6_20260719_163403.mp3","f":"HAD_6_20260719_163403.mp3","cap":"Good pace today as well, mate, good pace. Yeah, nothing I can do more honestly. So all that, it's a bit frustrating because, yeah, could be on this podium, so. Yeah, Carbis there, unfortunately with penalty. You did what you could today, good man."}],"HAM":[{"lap":3,"t":"13:08:52","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_150827.mp3","f":"HAM_44_20260719_150827.mp3","cap":"Car crossed over in front of me. I was right behind another car so I had no front end."},{"lap":13,"t":"13:30:12","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_152954.mp3","f":"HAM_44_20260719_152954.mp3","cap":"I'm quicker than Charles, I've got more pace."},{"lap":18,"t":"13:39:50","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_153914.mp3","f":"HAM_44_20260719_153914.mp3","cap":"What lap are we on? We are on lap 18. Why the hell? I told you what strategy I wanted to do. Just to put me out with everyone else now. We are on plan B."},{"lap":20,"t":"13:42:55","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_154223.mp3","f":"HAM_44_20260719_154223.mp3","cap":"We are opening the gap to Piastri and we need to serve a 5 second penalty, that's why."},{"lap":21,"t":"13:45:56","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_154537.mp3","f":"HAM_44_20260719_154537.mp3","cap":"Is it okay? Okay, all okay."},{"lap":24,"t":"13:52:02","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_155123.mp3","f":"HAM_44_20260719_155123.mp3","cap":"You keep putting front wing in or not? We need a manager. Yeah. I can't turn the cars in."},{"lap":44,"t":"14:32:09","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_163152.mp3","f":"HAM_44_20260719_163152.mp3","cap":"Yeah, it's a quick test, of course. Copy. Copy."},{"lap":44,"t":"14:32:40","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_163216.mp3","f":"HAM_44_20260719_163216.mp3","cap":""},{"lap":44,"t":"14:32:40","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HAM_44_20260719_163219.mp3","f":"HAM_44_20260719_163219.mp3","cap":"You can put it like this and say today, I just, I don't know if that's what that's supposed to mean."}],"HUL":[{"lap":9,"t":"13:22:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HUL_27_20260719_152201.mp3","f":"HUL_27_20260719_152201.mp3","cap":""},{"lap":9,"t":"13:22:35","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/HUL_27_20260719_152208.mp3","f":"HUL_27_20260719_152208.mp3","cap":"Here's Scooby, got the brother there in love. He should be right on track. Albon, coming across."}],"LEC":[{"lap":31,"t":"14:04:45","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/LEC_16_20260719_160412.mp3","f":"LEC_16_20260719_160412.mp3","cap":"These cars are secondaries to Stroll, Bottas, Alonso, Stroll, Bottas, Stroll, Bottas, Stroll, Bottas."},{"lap":44,"t":"14:30:38","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/LEC_16_20260719_163006.mp3","f":"LEC_16_20260719_163006.mp3","cap":"Peter, good race, Charles, well done. Good work, Charles, good job. I was close, but only a bit lucky with the VSC. That was a good one, yeah. This may be..."},{"lap":44,"t":"14:32:40","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/LEC_16_20260719_163216.mp3","f":"LEC_16_20260719_163216.mp3","cap":"Uh..."}],"LIN":[{"lap":44,"t":"14:34:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/LIN_41_20260719_163621.mp3","f":"LIN_41_20260719_163621.mp3","cap":"Yeah, thank you everyone. I really tried. It's a shame about the VSC, but regardless, a really good weekend again, so thank you for the work."}],"NOR":[{"lap":30,"t":"14:01:41","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/NOR_1_20260719_160127.mp3","f":"NOR_1_20260719_160127.mp3","cap":"And Lano, I don't want any yo-yo racing with Oscar. I'll explain why later."}],"OCO":[{"lap":1,"t":"12:54:09","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/OCO_31_20260719_145336.mp3","f":"OCO_31_20260719_145336.mp3","cap":"So we expect a very small shower, five minutes after the race start, but it should last about four minutes and very light rain."}],"PIA":[{"lap":8,"t":"13:21:05","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/PIA_81_20260719_152048.mp3","f":"PIA_81_20260719_152048.mp3","cap":"I can't believe enough space. That could have been a massive crash. You saw?"},{"lap":41,"t":"14:22:00","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/PIA_81_20260719_162145.mp3","f":"PIA_81_20260719_162145.mp3","cap":"Hamilton under investigation post-race for unsafe release. We'll stay within five seconds. Hamilton under investigation post-race."}],"SAI":[{"lap":1,"t":"12:55:40","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/SAI_55_20260719_145529.mp3","f":"SAI_55_20260719_145529.mp3","cap":"Subtitles by the Amara.org community"},{"lap":44,"t":"14:32:09","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/SAI_55_20260719_163145.mp3","f":"SAI_55_20260719_163145.mp3","cap":"Yeah, well done Carlos, good recovery, good pace, it's the best we had in it after that fact change this morning. Yeah, thank you."}],"VER":[{"lap":44,"t":"14:31:08","url":"https://livetiming.formula1.com/static/2026/2026-07-19_Belgian_Grand_Prix/2026-07-19_Race/TeamRadio/VER_3_20260719_163033.mp3","f":"VER_3_20260719_163033.mp3","cap":"Yeah, good job guys. I mean, it's the last podium. We're unlucky with that VSC, but it's all good. Well done, Max. The pace is getting better. You were very strong, as you say. Unlucky for P2, but it's close enough to the top and we have more coming. So, thanks for bearing with us. Yeah, exactly that. It's a tiny bit unlucky, but it's still a good podium."}]},"11":{"ANT":[{"lap":49,"t":"14:13:05","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/ANT_12_20260726_161227.mp3","f":"ANT_12_20260726_161227.mp3","cap":"Again, a little bit of security, just keep up. 3, 2, 7, get tight again."},{"lap":54,"t":"14:19:43","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/ANT_12_20260726_161904.mp3","f":"ANT_12_20260726_161904.mp3","cap":"But can't we go until yet? We don't think we have the tyre life, so press hold boost, press hold boost."},{"lap":55,"t":"14:22:15","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/ANT_12_20260726_162136.mp3","f":"ANT_12_20260726_162136.mp3","cap":"So, probably P6 potential, but P2 here, Kimmich, we've got a big offset on tyres."},{"lap":58,"t":"14:25:50","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/ANT_12_20260726_162520.mp3","f":"ANT_12_20260726_162520.mp3","cap":"Come on, I think I was ahead. Yeah, we're just talking through. We think we were."},{"lap":70,"t":"14:46:18","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/ANT_12_20260726_165018.mp3","f":"ANT_12_20260726_165018.mp3","cap":"Nice work, Kimi. P3, bud. Not a bad day. Uh, that was, uh, tough. Yeah, copy that. You earned your money today, mate. Uh, thanks, everyone. Was, uh, damage limitation after yesterday. So, thank you, everyone."}],"BEA":[{"lap":1,"t":"12:53:19","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/BEA_87_20260726_145310.mp3","f":"BEA_87_20260726_145310.mp3","cap":""}],"COL":[{"lap":68,"t":"14:46:18","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/COL_43_20260726_164802.mp3","f":"COL_43_20260726_164802.mp3","cap":"Choking pace, also slow."}],"HAM":[{"lap":12,"t":"13:19:13","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/HAM_44_20260726_151851.mp3","f":"HAM_44_20260726_151851.mp3","cap":"Max is pretty slow."},{"lap":35,"t":"13:53:46","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/HAM_44_20260726_155318.mp3","f":"HAM_44_20260726_155318.mp3","cap":"Now we are fighting for the position with Max, then we manage the tyres."},{"lap":68,"t":"14:40:32","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/HAM_44_20260726_164018.mp3","f":"HAM_44_20260726_164018.mp3","cap":"And we got 5 second penalty for speeding into the pit lane. I handed out penalties like crazy."}],"LAW":[{"lap":69,"t":"14:46:18","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/LAW_30_20260726_164928.mp3","f":"LAW_30_20260726_164928.mp3","cap":"It was pretty tough, good, really good job. Very good call on the strategy as well. Had me doubting it in the car, but very, very good job. Thank you. Car was so good. We wanted to keep you active, you know? We didn't want you to fall asleep. I literally said I don't want to overtake cars at the end of the race, and that's what you had me do. But you see, you could do it."}],"LEC":[{"lap":27,"t":"13:41:04","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/LEC_16_20260726_154053.mp3","f":"LEC_16_20260726_154053.mp3","cap":"We are losing quite a bit of time."},{"lap":50,"t":"14:14:38","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/LEC_16_20260726_161356.mp3","f":"LEC_16_20260726_161356.mp3","cap":"Copy. Looks like overheating. You can get back into the rhythm. Should help. Copy."}],"NOR":[{"lap":10,"t":"13:17:11","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_151629.mp3","f":"NOR_1_20260726_151629.mp3","cap":"How's the tyres? How's the pulse? 30, yeah, really. Much faster, but, yeah, just 30, yeah."},{"lap":30,"t":"13:45:38","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_154526.mp3","f":"NOR_1_20260726_154526.mp3","cap":"Okay mate, let's get back in the rhythm. Know what you've been trying to do, can we see it? Back in the rhythm please."},{"lap":32,"t":"13:49:13","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_154842.mp3","f":"NOR_1_20260726_154842.mp3","cap":"Hamilton's got me stuck behind the jar, and they thought to be an exit, but I need to get past, come on, let's do something, please. I know, mate, I know. Verstappen's gonna close in. I'm on boxes left."},{"lap":33,"t":"13:50:13","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_154941.mp3","f":"NOR_1_20260726_154941.mp3","cap":"You mean you don't like me? I'm Biles Master."},{"lap":34,"t":"13:50:43","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_155006.mp3","f":"NOR_1_20260726_155006.mp3","cap":"Help me out at 1060 for dark spots."},{"lap":43,"t":"14:04:27","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_160406.mp3","f":"NOR_1_20260726_160406.mp3","cap":"We're catching Antonelli 90 quickly. That's just been measured when we get there."},{"lap":54,"t":"14:20:14","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_161945.mp3","f":"NOR_1_20260726_161945.mp3","cap":"You're clearly the fastest car and have nothing to prove, so the snaps are 4 and 8, no more."},{"lap":67,"t":"14:38:32","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_163816.mp3","f":"NOR_1_20260726_163816.mp3","cap":"No exit curb. That may be what happened to Oscar's car."},{"lap":70,"t":"14:44:38","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_164359.mp3","f":"NOR_1_20260726_164359.mp3","cap":"Well done, mate. Well done. Beautiful! Car was unbelievable today. Well done, guys. Incredible. Flying, thank you so much for the car. Nice to finally be able to do it all for you again. Feels like it's been a while, so... Congrats, very well deserved. Hard work pays off. Just keep it going. Thank you very much. I love you all."},{"lap":70,"t":"14:46:18","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/NOR_1_20260726_164736.mp3","f":"NOR_1_20260726_164736.mp3","cap":"And Lando, Barnsey put it on your piece of tape. One who's laughing. I only did it for him. Thanks Barnsey for everything. Beautiful career. I did it on a high. Thank you very much for everything."}],"OCO":[{"lap":68,"t":"14:46:18","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/OCO_31_20260726_164834.mp3","f":"OCO_31_20260726_164834.mp3","cap":"Thank you Laura. Yeah, positive weekend. It's a lot of good stuff. Even if the race was very difficult, not as good as we would have liked it. Take the positive for you guys. And we'll come back stronger after the break."}],"PIA":[{"lap":1,"t":"12:53:19","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_145312.mp3","f":"PIA_81_20260726_145312.mp3","cap":""},{"lap":11,"t":"13:18:13","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_151736.mp3","f":"PIA_81_20260726_151736.mp3","cap":"How's the title? Currently we are thinking plan A, target level. Right, we'll shoot."},{"lap":26,"t":"13:40:02","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_153950.mp3","f":"PIA_81_20260726_153950.mp3","cap":"We're aiming at planet A, target that. How's the time? Oh yeah, it doesn't feel great."},{"lap":39,"t":"13:58:21","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_155750.mp3","f":"PIA_81_20260726_155750.mp3","cap":"Hey, don't you guys f****** think we're lost?"},{"lap":39,"t":"13:58:51","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_155835.mp3","f":"PIA_81_20260726_155835.mp3","cap":"Get out of the f***ing way, you idiots! Oh my god."},{"lap":41,"t":"14:01:55","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/PIA_81_20260726_160114.mp3","f":"PIA_81_20260726_160114.mp3","cap":"After that, Sainz puts the cost plus that. Target is to get to the end on this tyre. Oh mate, it's better you don't f***ing call me now. Nice of you guys to affect the other one in my voice. Thanks."}],"RUS":[{"lap":2,"t":"13:05:31","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/RUS_63_20260726_150501.mp3","f":"RUS_63_20260726_150501.mp3","cap":"2% shallow, it was a throttle pedal you backed up, high RPM."}],"VER":[{"lap":7,"t":"13:12:07","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/VER_3_20260726_151141.mp3","f":"VER_3_20260726_151141.mp3","cap":"Russell again, the dumping failed for sure."},{"lap":11,"t":"13:18:43","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/VER_3_20260726_151824.mp3","f":"VER_3_20260726_151824.mp3","cap":"Please do something about this shift, and don't tell me it's me shifting later. Absolutely."},{"lap":17,"t":"13:27:21","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/VER_3_20260726_152648.mp3","f":"VER_3_20260726_152648.mp3","cap":"Well, that was quite special. I don't want to complain, but that was, again, moving on the braking. I mean, sorry, section, but it's not right."},{"lap":50,"t":"14:15:08","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/VER_3_20260726_161437.mp3","f":"VER_3_20260726_161437.mp3","cap":"This is good, Max. You got it. You might have some fun towards the end."},{"lap":70,"t":"14:45:38","url":"https://livetiming.formula1.com/static/2026/2026-07-26_Hungarian_Grand_Prix/2026-07-26_Race/TeamRadio/VER_3_20260726_164505.mp3","f":"VER_3_20260726_164505.mp3","cap":"That is an excellent drive Max, really, really, really spot on. I would like to be a C-Sprog to you of a showcase finale, but none the less, I couldn't be prouder of that final sit. That's a great move done there as well, so, fantastic job. Yeah, we had a f***ing second today in some way or another. Right, so, well, it's been quite a lot out there, so..."}]}}}